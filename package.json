{
  "name": "turbosheet",
  "version": "0.4.0",
  "description": "Fast, small, streaming-first XLSX and CSV library for TypeScript on every JavaScript runtime (Node, Bun, Deno, browsers, workers).",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "csv",
    "ooxml",
    "streaming",
    "exceljs",
    "typescript",
    "encryption",
    "worksheet",
    "formula"
  ],
  "homepage": "https://github.com/lamberto15/turbosheet#readme",
  "bugs": {
    "url": "https://github.com/lamberto15/turbosheet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamberto15/turbosheet.git"
  },
  "author": "turbosheet contributors",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.ts",
        "default": "./dist/lite.js"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    },
    "./csv": {
      "import": {
        "types": "./dist/csv.d.ts",
        "default": "./dist/csv.js"
      },
      "require": {
        "types": "./dist/csv.d.cts",
        "default": "./dist/csv.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.js"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto.d.ts",
        "default": "./dist/crypto.js"
      },
      "require": {
        "types": "./dist/crypto.d.cts",
        "default": "./dist/crypto.cjs"
      }
    },
    "./formula": {
      "import": {
        "types": "./dist/formula.d.ts",
        "default": "./dist/formula.js"
      },
      "require": {
        "types": "./dist/formula.d.cts",
        "default": "./dist/formula.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lite": [
        "dist/lite.d.ts"
      ],
      "csv": [
        "dist/csv.d.ts"
      ],
      "json": [
        "dist/json.d.ts"
      ],
      "crypto": [
        "dist/crypto.d.ts"
      ],
      "formula": [
        "dist/formula.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "bench": "node --expose-gc bench/run.mjs",
    "size": "size-limit",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.5",
    "exceljs": "4.4.0",
    "size-limit": "^11.0.0",
    "tinybench": "^3.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "size-limit": [
    {
      "name": "write-only",
      "path": "dist/index.js",
      "import": "{ Workbook, writeXlsx }",
      "limit": "35 KB"
    },
    {
      "name": "read+write",
      "path": "dist/index.js",
      "import": "*",
      "limit": "76 KB"
    },
    {
      "name": "lite write-only",
      "path": "dist/lite.js",
      "import": "{ Workbook, writeXlsx }",
      "limit": "23.5 KB"
    },
    {
      "name": "lite read+write",
      "path": "dist/lite.js",
      "import": "{ Workbook, readXlsx, writeXlsx }",
      "limit": "42.5 KB"
    },
    {
      "name": "lite write + tables + images",
      "path": "dist/lite.js",
      "import": "{ Workbook, writeXlsx, addTable, tablesWriter, addImage, placeImage, imagesWriter }",
      "limit": "27.5 KB"
    },
    {
      "name": "lite autofit",
      "path": "dist/lite.js",
      "import": "{ Workbook, autoFitColumns }",
      "limit": "11 KB"
    },
    {
      "name": "lite write + charts",
      "path": "dist/lite.js",
      "import": "{ Workbook, writeXlsx, addChart, chartsWriter }",
      "limit": "27 KB"
    },
    {
      "name": "csv",
      "path": "dist/csv.js",
      "import": "*",
      "limit": "2.9 KB"
    },
    {
      "name": "crypto",
      "path": "dist/crypto.js",
      "import": "*",
      "limit": "7.7 KB"
    },
    {
      "name": "formula",
      "path": "dist/formula.js",
      "import": "*",
      "limit": "17 KB"
    }
  ],
  "packageManager": "pnpm@12.16.1"
}
